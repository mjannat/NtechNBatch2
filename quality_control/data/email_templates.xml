<odoo>
    <data noupdate="1">
        <!-- Mail Template for Quality Check Manager Notification -->
        <record id="email_template_quality_check_manager" model="mail.template">
            <field name="name">Quality Check: Send to Manager Notification</field>
            <field name="model_id" ref="model_quality_check"/>
            <field name="subject">
                Quality Check Pending Approval: ${object.name}
            </field>
            <field name="email_to">
                ${','.join(object.env.ref(
                'quality_control.group_quality_check_manager'
                ).users.mapped('email'))}
            </field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, Helvetica, sans-serif;font-size: 14px; color: #333333;">
                    <p>Hello Managers,</p>
                    <p>
                        A new quality check
                        <b>${object.name}</b>
                        has been submitted for your review by
                        <b>${object.inspector_id.name}</b>.
                    </p>
                    <p>
                        <b>Check Date:</b>
                        ${object.check_date or ''}
                    </p>
                    <p>Please click the link below to review and take action:</p>
                    <p style="text-align: center; margin: 16px 0;">
                        <a href="/web#id=${object.id}&amp;model=quality.check&amp;view_type=form"
                           style="background-color: #875A7B;color: #ffffff;padding: 10px 20px;text-decoration: none;border-radius: 5px;">
                        </a>
                    </p>
                    <p>Thank you!</p>
                </div>
            </field>
        </record>
    </data>
</odoo>